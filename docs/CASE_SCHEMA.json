{
  "$defs": {
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "kind": {
          "enum": [
            "source_fact",
            "inference",
            "recommendation"
          ],
          "title": "Kind",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "claim_id",
        "text",
        "kind",
        "evidence_ids"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Freshness": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "current",
            "needs_recheck",
            "deprecated"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "updated_at": {
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason",
        "updated_at"
      ],
      "title": "Freshness",
      "type": "object"
    },
    "Requirement": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "enum": [
            "framework",
            "framework_version",
            "data_external",
            "approval",
            "idempotency"
          ],
          "title": "Key",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "critical": {
          "default": true,
          "title": "Critical",
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "title": "Requirement",
      "type": "object"
    },
    "Review": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "draft",
            "source_checked",
            "reviewed"
          ],
          "title": "Status",
          "type": "string"
        },
        "reviewer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reviewer"
        },
        "at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "At"
        },
        "scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Scope"
        }
      },
      "required": [
        "status",
        "reviewer",
        "at",
        "scope"
      ],
      "title": "Review",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "source_type": {
          "enum": [
            "code",
            "official_doc",
            "local_experiment"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Url"
        },
        "repo": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Repo"
        },
        "revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Revision"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Path"
        },
        "symbol": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Symbol"
        },
        "lines": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Lines"
        },
        "observed_at": {
          "title": "Observed At",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "license_status": {
          "title": "License Status",
          "type": "string"
        },
        "content_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Content Hash"
        },
        "mutable": {
          "title": "Mutable",
          "type": "boolean"
        }
      },
      "required": [
        "source_id",
        "source_type",
        "url",
        "repo",
        "revision",
        "path",
        "symbol",
        "lines",
        "observed_at",
        "title",
        "license_status",
        "content_hash",
        "mutable"
      ],
      "title": "Source",
      "type": "object"
    },
    "Validation": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "not_run",
            "local_passed",
            "independently_reproduced"
          ],
          "title": "Status",
          "type": "string"
        },
        "environment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Environment"
        },
        "command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Command"
        },
        "result": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Result"
        }
      },
      "required": [
        "status",
        "environment",
        "command",
        "result"
      ],
      "title": "Validation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[a-z][a-z0-9-]{2,60}$",
      "title": "Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "locale": {
      "enum": [
        "zh-CN",
        "en"
      ],
      "title": "Locale",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "problem_cluster": {
      "enum": [
        "retrieval",
        "recovery",
        "safety"
      ],
      "title": "Problem Cluster",
      "type": "string"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "aliases": {
      "items": {
        "type": "string"
      },
      "title": "Aliases",
      "type": "array"
    },
    "problem": {
      "title": "Problem",
      "type": "string"
    },
    "context": {
      "title": "Context",
      "type": "string"
    },
    "preconditions": {
      "items": {
        "type": "string"
      },
      "title": "Preconditions",
      "type": "array"
    },
    "hard_requirements": {
      "items": {
        "$ref": "#/$defs/Requirement"
      },
      "title": "Hard Requirements",
      "type": "array"
    },
    "required_components": {
      "items": {
        "type": "string"
      },
      "title": "Required Components",
      "type": "array"
    },
    "approach": {
      "title": "Approach",
      "type": "string"
    },
    "alternatives": {
      "items": {
        "type": "string"
      },
      "title": "Alternatives",
      "type": "array"
    },
    "tradeoffs": {
      "items": {
        "type": "string"
      },
      "title": "Tradeoffs",
      "type": "array"
    },
    "failure_modes": {
      "items": {
        "type": "string"
      },
      "title": "Failure Modes",
      "type": "array"
    },
    "not_applicable": {
      "items": {
        "type": "string"
      },
      "title": "Not Applicable",
      "type": "array"
    },
    "implementation_steps": {
      "items": {
        "type": "string"
      },
      "title": "Implementation Steps",
      "type": "array"
    },
    "validation_plan": {
      "items": {
        "type": "string"
      },
      "title": "Validation Plan",
      "type": "array"
    },
    "frameworks": {
      "items": {
        "type": "string"
      },
      "title": "Frameworks",
      "type": "array"
    },
    "tested_versions": {
      "items": {
        "type": "string"
      },
      "title": "Tested Versions",
      "type": "array"
    },
    "applicable_version_range": {
      "title": "Applicable Version Range",
      "type": "string"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Claims",
      "type": "array"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/Source"
      },
      "title": "Sources",
      "type": "array"
    },
    "review": {
      "$ref": "#/$defs/Review"
    },
    "validation": {
      "$ref": "#/$defs/Validation"
    },
    "freshness": {
      "$ref": "#/$defs/Freshness"
    },
    "contributors": {
      "items": {
        "type": "string"
      },
      "title": "Contributors",
      "type": "array"
    },
    "ai_assistance": {
      "title": "Ai Assistance",
      "type": "boolean"
    },
    "body": {
      "default": "",
      "title": "Body",
      "type": "string"
    }
  },
  "required": [
    "id",
    "schema_version",
    "revision",
    "locale",
    "title",
    "problem_cluster",
    "tags",
    "aliases",
    "problem",
    "context",
    "preconditions",
    "hard_requirements",
    "required_components",
    "approach",
    "alternatives",
    "tradeoffs",
    "failure_modes",
    "not_applicable",
    "implementation_steps",
    "validation_plan",
    "frameworks",
    "tested_versions",
    "applicable_version_range",
    "claims",
    "sources",
    "review",
    "validation",
    "freshness",
    "contributors",
    "ai_assistance"
  ],
  "title": "Card",
  "type": "object"
}